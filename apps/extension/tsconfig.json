{
  "compilerOptions": {
    "strict": false,
    "skipLibCheck": true,
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["chrome", "node"],
    "baseUrl": ".",
    "paths": {
      "~*": ["./*"]
    }
  },
  "include": [".plasmo/index.d.ts", "src", "plasmo.config.ts"],
  "exclude": ["node_modules", "build", ".plasmo"]
}
