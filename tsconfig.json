{
  "compilerOptions": {
    "strict": false,
    "skipLibCheck": true,
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "."
  },
  "exclude": ["node_modules", "apps/web/.next", "apps/extension/build"]
}
