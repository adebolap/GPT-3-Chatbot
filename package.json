{
  "name": "contxt-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @contxt/web",
    "dev:extension": "npm run dev -w @contxt/extension",
    "build:web": "npm run build -w @contxt/web",
    "build:extension": "npm run build -w @contxt/extension",
    "smoke:web": "node scripts/smoke-web.mjs"
  }
}
